{
  "name": "fittrack",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:db": "npm run dev:db -w @fittrack/api",
    "dev:api": "npm run dev -w @fittrack/api",
    "dev:web": "npm run dev -w @fittrack/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "neon:migrate": "npm run neon:migrate -w @fittrack/api",
    "neon:start": "npm run neon:start -w @fittrack/api",
    "neon:create-user": "npm run neon:create-user -w @fittrack/api --",
    "create-user": "npm run create-user -w @fittrack/api --"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neon/config": "^1.10.1",
    "@neon/env": "^1.6.9"
  }
}
