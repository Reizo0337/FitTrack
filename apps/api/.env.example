# Copia a .env y rellena. NUNCA subas .env al repositorio.
DATABASE_URL="postgresql://fittrack:fittrack@localhost:5433/fittrack"
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=
PORT=3000
CORS_ORIGINS=http://localhost:5173
# --- Opcionales ---
# Notificaciones push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com
# Programador externo de recordatorios (>= 24 caracteres)
CRON_SECRET=
# Límite diario de llamadas a modelos de IA
AI_DAILY_LIMIT=60
# Servir la web compilada desde el mismo origen (producción): ruta a apps/web/dist
STATIC_DIR=
