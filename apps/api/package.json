{
  "name": "@fittrack/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "neon:migrate": "node --env-file=../../.env.local ../../node_modules/prisma/build/index.js migrate deploy",
    "neon:start": "node --env-file=../../.env.local --import tsx src/server.ts",
    "neon:create-user": "node --env-file=../../.env.local --import tsx scripts/create-user.ts",
    "create-user": "tsx scripts/create-user.ts",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.9",
    "@fittrack/shared": "*",
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "tsx": "^4.19.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
